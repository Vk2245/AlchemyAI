# ==========================================
# Alchemy AI - Global Git Ignore
# ==========================================

# ------------------------------------------
# 1. Global Exclusions
# ------------------------------------------
# OS generated files
.DS_Store
Thumbs.db

# Environments
.env
.env.*
!.env.example
venv/
env/
ENV/
.venv/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Text & Markdown (with exceptions)
*.md
*.txt
!README.md
!requirements.txt

# Databases
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# 2. Python / Backend / AI-ML
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Uploads & Reports (Generated Data)
DEV/backend/reports/
DEV/backend/uploads/

# AI / ML Model Artifacts & Datasets
AI-ML/training/models/
*.safetensors
*.onnx
*.pt
*.pth
*.bin
AI-ML/dataset/
AI-ML/data/

# ------------------------------------------
# 3. Node.js / Frontend (Next.js)
# ------------------------------------------
node_modules/
DEV/frontend/node_modules/
DEV/backend/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js & Build Artifacts
DEV/frontend/.next/
DEV/frontend/out/
DEV/frontend/dist/
DEV/frontend/build/
DEV/backend/dist/
coverage/
*.tsbuildinfo
DEV/frontend/next-env.d.ts
DEV/frontend/.vercel/
# ------------------------------------------
# 4. Irrelevant / Scratch / Temp Files
# ------------------------------------------
Testing/
DEV/skills/
bug_fixes/
bug fixes/
cleanup.py
scratch_chat_test.py
test_vllm.py
update_chat.js
catalogx.db
fix_*.py
patch_*.py
