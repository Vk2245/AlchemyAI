# ==========================================
# CatalogX - Common Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values.
# The .env file is ignored by Git to keep secrets safe.

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------
# Backend (FastAPI)
# ------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./catalogx.db
SECRET_KEY=super_secret_jwt_key_for_demo_123
HMAC_KEY=super_secret_hmac_key_for_tamper_proof_123
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.6.89:3000

# ------------------------------------------
# AI-ML Pipeline & Models
# ------------------------------------------
# Ollama (local, primary provider for everything)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# vLLM (high-throughput local inference via WSL2/Linux)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ

# ==========================================
# DEFAULT LLM PROVIDER SELECTION
# ==========================================
# Options available:
# 1. 'gemini' -> (Recommended) Uses Gemini 2.5 Flash API. Smartest & fastest for Chat/Pipeline.
# 2. 'groq'   -> Uses Llama-3.3-70b via Groq API. Extremely fast text generation.
# 3. 'vllm'   -> Uses local Qwen2-VL-2B model. Free & private, but less smart for complex logic.
# 
# Note: Changing this affects BOTH the Chatbot and the main AI-ML extraction pipeline.
# Change the value below to switch the active model:
DEFAULT_PROVIDER=gemini

# Vision embedding model (runs locally via transformers, no API)
VISION_EMBED_MODEL=nomic-ai/nomic-embed-vision-v1.5

# Groq (FALLBACK ONLY -- when local quality is insufficient)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Gemini (FALLBACK ONLY -- when local cannot handle long context)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini/gemini-2.5-flash

# Paths for AI-ML Data
DATA_DIR=./AI-ML/data
CHROMA_DB_DIR=./AI-ML/data/chroma_db
REPORTS_DIR=./AI-ML/data/reports
CORRECTION_LOG_PATH=./AI-ML/data/corrections.json

# ------------------------------------------
# Web Search & Risk Radar
# ------------------------------------------
TAVILY_API_KEY=your-tavily-api-key-here
SERPER_API_KEY=your-serper-api-key-here

# ------------------------------------------
# OCR Fallbacks
# ------------------------------------------
OCR_SPACE_API_KEY=your-ocr-space-api-key-here
